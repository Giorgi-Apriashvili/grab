{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "grab: dry-run folder",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": ["-f", "releases", "E:\\Backup\\releases", "--dry-run", "-v"],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated"
    },
    {
      "name": "grab: --help",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": ["--help"],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated"
    }
  ]
}
