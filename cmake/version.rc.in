// Windows version resource shared by grab.exe and grab-gui.exe. CMake configures this into
// <build>/version.rc; each program's .rc defines GRAB_FILE_DESCRIPTION and GRAB_FILE_NAME and
// then includes it. Explorer's Properties, Task Manager and notifications read these strings.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Giorgi Apriashvili"
            VALUE "FileDescription",  GRAB_FILE_DESCRIPTION
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     GRAB_FILE_NAME
            VALUE "OriginalFilename", GRAB_FILE_NAME
            VALUE "ProductName",      "grab"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "Copyright (c) Giorgi Apriashvili. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
