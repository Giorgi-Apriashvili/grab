; Inno Setup script for grab. CMake configures this template into <build>/installer/grab.iss;
; edit installer/grab.iss.in in the source tree, not the generated copy.
;
; Per-user installer: no admin rights, installs to %USERPROFILE%\programs\grab, adds bin to the
; user PATH, adds a Start-menu entry for grab-gui, writes the default config with `grab --init`
; if none exists. The uninstaller removes the files, shortcuts, PATH entry and grab-gui's browser
; cache, but leaves %APPDATA%\grab (config, servers, host keys) alone.
;
; `grab update` runs this silently over an existing install. A running grab-gui is closed through
; the Restart Manager and started again afterwards (it calls RegisterApplicationRestart). grab 0.20
; and earlier installed rclone.exe beside grab.exe; this one removes that copy (CurStepChanged).

[Setup]
AppId={{B7E9C1D4-5F2A-4C3E-9A8B-2D6F1E0C7A55}
AppName=grab
AppVersion=@PROJECT_VERSION@
AppVerName=grab @PROJECT_VERSION@
AppPublisher=Giorgi Apriashvili
AppPublisherURL=https://github.com/Giorgi-Apriashvili/grab
AppSupportURL=https://github.com/Giorgi-Apriashvili/grab/issues
DefaultDirName={%USERPROFILE}\programs\grab
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
ChangesEnvironment=yes
LicenseFile=@GRAB_STAGE_DIR_NATIVE@\LICENSE
OutputDir=@GRAB_DIST_DIR_NATIVE@
OutputBaseFilename=grab-@PROJECT_VERSION@-windows-x64-setup
UninstallDisplayName=grab
UninstallDisplayIcon={app}\bin\grab-gui.exe
SetupIconFile=@GRAB_ICON_NATIVE@
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
CloseApplications=yes
RestartApplications=yes

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Shortcuts:"; Flags: unchecked

[Files]
Source: "@GRAB_STAGE_DIR_NATIVE@\grab.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
; The window (WebView2); needs the Edge WebView2 Runtime, see WebView2Installed below.
Source: "@GRAB_STAGE_DIR_NATIVE@\grab-gui.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
; rclone (MIT): grab reuses its file-name encoding tables and password-obscuring key.
Source: "@GRAB_STAGE_DIR_NATIVE@\licenses\rclone.txt"; DestDir: "{app}\licenses"; Flags: ignoreversion
; libssh2 (BSD-3-Clause) and OpenSSL (Apache-2.0), built into grab.exe and grab-gui.exe.
Source: "@GRAB_STAGE_DIR_NATIVE@\licenses\libssh2.txt"; DestDir: "{app}\licenses"; Flags: ignoreversion
Source: "@GRAB_STAGE_DIR_NATIVE@\licenses\openssl.txt"; DestDir: "{app}\licenses"; Flags: ignoreversion
Source: "@GRAB_STAGE_DIR_NATIVE@\grab.conf.example"; DestDir: "{app}"; Flags: ignoreversion
Source: "@GRAB_STAGE_DIR_NATIVE@\README.md"; DestDir: "{app}"; Flags: ignoreversion
; The full documentation, which README.md links to as docs/doc.md.
Source: "@GRAB_STAGE_DIR_NATIVE@\docs\doc.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "@GRAB_STAGE_DIR_NATIVE@\LICENSE"; DestDir: "{app}"; Flags: ignoreversion

[Registry]
; Append bin to the user PATH only when it is not already there. expandsz keeps existing
; %VAR% entries unexpanded. ChangesEnvironment=yes makes Inno broadcast the change afterwards.
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}\bin"; Check: NeedsAddPath(ExpandConstant('{app}\bin'))

[Icons]
; Per-user locations, so no admin rights are needed. Windows search finds the Start-menu entry.
Name: "{userprograms}\grab"; Filename: "{app}\bin\grab-gui.exe"; WorkingDir: "{app}"; Comment: "Find and download files from your servers"
Name: "{userdesktop}\grab"; Filename: "{app}\bin\grab-gui.exe"; WorkingDir: "{app}"; Comment: "Find and download files from your servers"; Tasks: desktopicon

[UninstallDelete]
; Inno removes only directories it created. When {app} pre-existed (a developer ran
; `cmake --install` into the same folder) this at least removes the emptied bin folder; {app}
; itself still holds unins000.exe while this runs, so an empty {app} stays behind in that case.
; %APPDATA%\grab is deliberately left alone; grab-gui's WebView2 profile (browser cache, not
; settings) in %LOCALAPPDATA%\grab is removed. Of the .old files only grab's own go: other programs
; in the same folder keep theirs (review G31).
Type: files; Name: "{app}\bin\grab.exe.old"
Type: files; Name: "{app}\bin\grab-gui.exe.old"
Type: files; Name: "{app}\bin\rclone.exe.grab-old"
Type: dirifempty; Name: "{app}\bin"
Type: dirifempty; Name: "{app}\licenses"
Type: dirifempty; Name: "{app}\docs"
Type: filesandordirs; Name: "{localappdata}\grab\WebView2"
Type: dirifempty; Name: "{localappdata}\grab"

[Run]
Filename: "{app}\bin\grab.exe"; Parameters: "--init"; Flags: runhidden waituntilterminated; StatusMsg: "Writing the default configuration to %APPDATA%\grab\grab.conf..."
Filename: "{app}\bin\grab-gui.exe"; Description: "Launch grab"; Flags: postinstall nowait skipifsilent

[Code]
// The Edge WebView2 Runtime grab-gui renders with: its version ("pv") under the EdgeUpdate
// client key, per machine or per user. See Microsoft's "Detect if a WebView2 Runtime is
// already installed" guidance.
function WebView2Installed(): Boolean;
var
  Version: string;
  Key: string;
begin
  Key := 'SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}';
  Result := False;
  if RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) or
     RegQueryStringValue(HKLM64, Key, 'pv', Version) or
     RegQueryStringValue(HKCU, Key, 'pv', Version) then
    Result := (Version <> '') and (Version <> '0.0.0.0');
#ifdef GRAB_TEST_NO_WEBVIEW2
  Result := False;
#endif
end;

// Without the runtime the grab command still works; say so on the last page instead of failing.
procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpFinished) and not WebView2Installed() then
    WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 +
      'The grab window needs the Microsoft Edge WebView2 Runtime, which is not installed on this PC. ' +
      'Get it from https://go.microsoft.com/fwlink/p/?LinkId=2124703 (grab offers the link when it ' +
      'starts, too). The grab command in a terminal works without it.';
end;

// True when Dir is not yet an entry of the user PATH. Whole-entry, case-insensitive match,
// tolerant of a trailing backslash on the stored entry.
function NeedsAddPath(Dir: string): Boolean;
var
  Path, Haystack, Needle: string;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path) then
    Path := '';
  Haystack := ';' + Uppercase(Path) + ';';
  Needle := Uppercase(RemoveBackslash(Dir));
  Result := (Pos(';' + Needle + ';', Haystack) = 0) and (Pos(';' + Needle + '\;', Haystack) = 0);
end;

// Remove Dir from the user PATH, keeping every other entry byte for byte.
procedure RemoveFromUserPath(Dir: string);
var
  Path, Haystack, Needle: string;
  P: Integer;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path) then
    exit;
  Haystack := ';' + Uppercase(Path) + ';';
  Needle := ';' + Uppercase(RemoveBackslash(Dir)) + ';';
  P := Pos(Needle, Haystack);
  if P = 0 then
  begin
    Needle := ';' + Uppercase(RemoveBackslash(Dir)) + '\;';
    P := Pos(Needle, Haystack);
  end;
  if P = 0 then
    exit;
  // Haystack and the wrapped original line up position for position, so cut the entry (without
  // its trailing separator) out of the original-case string.
  Path := ';' + Path + ';';
  Delete(Path, P, Length(Needle) - 1);
  if (Length(Path) > 0) and (Path[1] = ';') then
    Delete(Path, 1, 1);
  if (Length(Path) > 0) and (Path[Length(Path)] = ';') then
    Delete(Path, Length(Path), 1);
  RegWriteExpandStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', Path);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    RemoveFromUserPath(ExpandConstant('{app}\bin'));
end;

// grab 0.20 and earlier installed rclone 1.75.1 in bin; 0.21 has no rclone. The rule grab itself
// applies at start (src/update.cpp, remove_old_rclone): only that very file goes, known by its
// exact size and SHA-256, so an rclone.exe of the user's own stays (review G31); nothing while a
// replaced grab.exe.old or grab-gui.exe.old is still there (an old grab-gui may still run and start
// it: grab removes it at a later start). A copy that runs can't be deleted, but it can be renamed:
// it is left as rclone.exe.grab-old, which grab deletes when it next starts.
const
  OldRcloneSize = 85192704;
  OldRcloneSha256 = '033eee51c9ad47c2de2624b6674d355274bcd6cf0027a5f85db4437ba24ae81c';
  NotPlainFile = $410;        // FILE_ATTRIBUTE_DIRECTORY ($10) or FILE_ATTRIBUTE_REPARSE_POINT ($400)
  NoAttributes = $FFFFFFFF;   // INVALID_FILE_ATTRIBUTES

function GetFileAttributes(lpFileName: String): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

// True for grab's old rclone: a plain file (a link may lead to someone's rclone elsewhere) of that
// size, then that SHA-256.
function IsOldRclone(const FileName: String): Boolean;
var
  Attributes: Cardinal;
  Size: Int64;
begin
  Result := False;
  Attributes := GetFileAttributes(FileName);
  if (Attributes = NoAttributes) or ((Attributes and NotPlainFile) <> 0) then
    exit;
  if not FileSize64(FileName, Size) or (Size <> OldRcloneSize) then
    exit;
  try
    Result := Lowercase(GetSHA256OfFile(FileName)) = OldRcloneSha256;
  except
    Result := False; // unreadable: not known to be grab's
  end;
end;

procedure RemoveOldRclone(const FileName: String);
var
  Aside: String;
begin
  if not IsOldRclone(FileName) then
    exit;
  Aside := ExpandConstant('{app}\bin\rclone.exe.grab-old');
  DeleteFile(Aside);
  if RenameFile(FileName, Aside) then
    DeleteFile(Aside)
  else
    DeleteFile(FileName);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Bin: String;
begin
  if CurStep <> ssPostInstall then
    exit;
  Bin := ExpandConstant('{app}\bin\');
  if FileOrDirExists(Bin + 'grab.exe.old') or FileOrDirExists(Bin + 'grab-gui.exe.old') then
    exit;
  RemoveOldRclone(Bin + 'rclone.exe');
  RemoveOldRclone(Bin + 'rclone.exe.old');
end;
